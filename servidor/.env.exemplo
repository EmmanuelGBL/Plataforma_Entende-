# Copie para .env e preencha. O .env NÃO vai para o repositório — ele é público.

# Banco. Sem esta linha, o servidor usa SQLite no arquivo entende.db, nesta pasta.
# ENTENDE_BANCO_URL=postgresql+psycopg://entende:SENHA@localhost:5432/entende

# Segredo que assina o token de acesso. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem ele, o servidor gera um aleatório a cada partida, e todo professor precisa
# entrar de novo sempre que o servidor reinicia.
# ENTENDE_SEGREDO_TOKEN=

# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula.
# ENTENDE_ORIGENS=http://localhost:5173,https://emmanuelgbl.github.io
